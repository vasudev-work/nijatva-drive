# Copy to .env (git-ignored) before running a local build.
# These values are inlined into the JS bundle at build time, so they are visible
# to anyone who unpacks the APK — Zoho treats mobile clients as public clients
# and mandates PKCE for exactly that reason. Rotate them from the API console
# whenever they leak. Never commit a real .env.

EXPO_PUBLIC_ZOHO_CLIENT_ID=
EXPO_PUBLIC_ZOHO_CLIENT_SECRET=
# Data centre the client was registered in: in | com | eu | au | jp | ca | sa
EXPO_PUBLIC_ZOHO_DC=in
