{
  "name": "nijatva-drive",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "server": "node server/index.js"
  },
  "private": true,
  "description": "Nijatva Drive \u2014 a private, offline-first file vault for Android, built with Expo and React Native.",
  "keywords": [
    "expo",
    "react-native",
    "drive",
    "file-manager",
    "android"
  ],
  "license": "MIT"
}
